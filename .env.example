Get-Content priority-engine\requirements.txt# ===================================================
# AI-POWERED DISASTER RESPONSE PLATFORM (VARAHI)
# Environment Configuration
# ===================================================

# Node.js Backend API
PORT=5000
NODE_ENV=development
FASTAPI_PRIORITY_URL=http://127.0.0.1:8000

# Supabase Configuration (PostgreSQL + PostGIS + Realtime)
# If left blank, the backend automatically operates with an in-memory/JSON store with seed data
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Twilio SMS Credentials
# If left blank, notifications are safely dispatched to local console & an in-memory audit log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Frontend Configuration
VITE_API_URL=http://localhost:5000
